    "content": "<p>&nbsp;</p>\n<div id='iksm-28934' class='iksm iksm-28934 iksm-container '  data-id='28934' data-is-pro='1' data-source='menu'><div class='iksm-terms'><div class='iksm-terms-tree iksm-terms-tree--level-1 iksm-terms-tree--parents' style=''><div class=\"iksm-terms-tree__inner\">\n        <div class=\"iksm-term iksm-term--id-28908 iksm-term--parent iksm-term--has-children\" data-id=\"28908\">\n            <div class=\"iksm-term__inner\" tabindex='0'>\n                <a class=\"iksm-term__link\" data-toggle='1' tabindex='-1'>\n\t\t\t\t        <span class=\"iksm-term__text\">Help &amp; How-to</span>\n\t\t            </a>\n\t\t\t            <div class=\"iksm-term__toggle\" tabindex=\"0\">\n                <span class=\"iksm-term__toggle__inner\"><i class='iks-icon-chevron-1'></i></span>\n            </div>\n\t\t\t        </div>\n\t\t<div class='iksm-terms-tree iksm-terms-tree--level-2 iksm-terms-tree--children' style=''><div class=\"iksm-terms-tree__inner\">\n        <div class=\"iksm-term iksm-term--id-28905 iksm-term--child\" data-id=\"28905\">\n            <div class=\"iksm-term__inner\" tabindex='0'>\n                <a class=\"iksm-term__link\" href='https://opensiddur.org/help/decision-tree-for-choosing-freelibre-licenses-for-cultural-and-technological-work/' target='_self' tabindex='-1'>\n\t\t\t\t            <div\n              class=\"iksm-term__shifts\"\n              style=\"width:6%; min-width:6%; max-width:6%;\"></div>\n\t\t\t        <span class=\"iksm-term__text\">Choosing a License</span>\n\t\t            </a>\n\t\t\t        </div>\n\t\t        </div>\n\n\t\t\n        <div class=\"iksm-term iksm-term--id-28906 iksm-term--child\" data-id=\"28906\">\n            <div class=\"iksm-term__inner\" tabindex='0'>\n                <a class=\"iksm-term__link\" href='https://opensiddur.org/help/style-guide/' target='_self' tabindex='-1'>\n\t\t\t\t            <div\n              class=\"iksm-term__shifts\"\n              style=\"width:6%; min-width:6%;